# Anthropic API (optioneel als je de gratis Google Vertalen modus gebruikt)
ANTHROPIC_API_KEY=sk-ant-api03-jouw-sleutel-hier

# Auth0 login-bescherming (optioneel — laat leeg voor geen login)
# Maak gratis account aan op https://auth0.com → Applications → Regular Web App
AUTH0_DOMAIN=jouw-naam.eu.auth0.com
AUTH0_CLIENT_ID=jouw-client-id
AUTH0_CLIENT_SECRET=jouw-client-secret

# URL van de app (voor Auth0 callback)
APP_URL=http://localhost:8501
